# Rebuildable Vivado project output. Keep project sources, constraints,
# packaged IP, block designs and saved GUI project files.
/vivado/**/*.cache/
/vivado/**/*.hw/
/vivado/**/*.sim/
/vivado/**/*.runs/
/vivado/**/*.gen/
/vivado/**/*.ip_user_files/
/vivado/**/*.srcs/utils_1/
/vivado/**/*.xpr.backup*

# Local host builds, exported deliverables and generated fixtures.
/build/
/artifacts/
/dv/vectors/
/vectors/
.venv/
__pycache__/
*.py[cod]
*.tmp
*~
.DS_Store

# Locally provisioned secure-link keys (never commit actual PSKs).
*.psk
